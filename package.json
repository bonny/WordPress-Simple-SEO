{
	"name": "simple-seo",
	"private": true,
	"description": "Build for the Simple SEO block editor panel.",
	"scripts": {
		"build": "wp-scripts build js/editor-panel.js js/share-image-field.js js/quick-edit.js --output-path=build",
		"start": "wp-scripts start js/editor-panel.js js/share-image-field.js js/quick-edit.js --output-path=build",
		"lint:js": "wp-scripts lint-js js",
		"format:js": "wp-scripts format js",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/simple-seo ./vendor/bin/phpunit"
	},
	"devDependencies": {
		"@wordpress/env": "^11.16.0",
		"@wordpress/scripts": "^36.0.0"
	},
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	}
}
