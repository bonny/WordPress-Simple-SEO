# macOS
.DS_Store

# WordPress.org SVN working copy (release tooling)
.svn

# Composer / static-analysis tooling
/vendor/

# npm (build/ is committed, node_modules is not)
/node_modules/
.phpcs.cache

# Playwright MCP browser-session artifacts
/.playwright-mcp/

# Local design drafts (icon/banner exploration), never committed
.design-drafts/

# PHPUnit
.phpunit.result.cache

# Private docs, symlinked from the Obsidian vault by scripts/setup-private-docs.sh
/todo.md
/todos
/CLAUDE.private.md
