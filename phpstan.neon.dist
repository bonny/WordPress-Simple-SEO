parameters:
	level: 5
	scanFiles:
		- tests/phpstan/simple-history-stubs.php
	paths:
		- simple-seo.php
		- src
	# WordPress function/constant stubs come from szepeviktor/phpstan-wordpress, and
	# johnbillion/wp-compat flags anything newer than the "Requires at least" floor.
	# Both are auto-registered via phpstan/extension-installer.
	WPCompat:
		requiresAtLeast: '6.6'
