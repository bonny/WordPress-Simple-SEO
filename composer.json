{
	"name": "bonny/simple-seo",
	"type": "wordpress-plugin",
	"description": "A deliberately tiny SEO plugin: a few fields per post, no settings maze.",
	"license": "GPL-2.0-or-later",
	"homepage": "https://wordpress.org/plugins/simple-seo/",
	"minimum-stability": "stable",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "*",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "*",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/extension-installer": "^1.3.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"johnbillion/wp-compat": "^1.1",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"authors": [
		{
			"name": "Pär Thernström",
			"homepage": "https://eskapism.se/"
		}
	],
	"support": {
		"forum": "https://wordpress.org/support/plugin/simple-seo/"
	},
	"scripts": {
		"lint": "./vendor/bin/phpcs",
		"lint-fix": "./vendor/bin/phpcbf",
		"phpstan": "./vendor/bin/phpstan analyse --memory-limit 1G",
		"check": [
			"@lint",
			"@phpstan"
		]
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
